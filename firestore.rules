rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function userCompanyId() {
      return userProfile().companyId;
    }

    function hasAllowedRole() {
      return userProfile().role in ['admin', 'supervisor', 'examiner', 'user'];
    }

    function sameCompany(docData) {
      return isSignedIn() && hasAllowedRole() && docData.companyId == userCompanyId();
    }

    function isAdmin() {
      return isSignedIn() && userProfile().role == 'admin';
    }

    // Block listing the legacy users collection
    match /users {
      allow list: if false;
    }

    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId);
      allow list: if false;
    }

    match /users/{userId}/{documentPath=**} {
      allow read, write: if isOwner(userId);
    }

    // Profiles: owner can always read/write own doc.
    // Company members can list profiles in their company (admin page).
    // Admins in the same company can update other profiles.
    match /user_profiles/{userId} {
      allow get: if isOwner(userId) || (isSignedIn() && hasAllowedRole() && resource.data.companyId == userCompanyId());
      allow list: if isSignedIn() && hasAllowedRole();
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update: if isOwner(userId) || (isAdmin() && resource.data.companyId == userCompanyId() && request.resource.data.companyId == userCompanyId());
      allow delete: if isAdmin() && resource.data.companyId == userCompanyId();
    }

    // Companies: members of the company can read; admins can update.
    match /companies/{companyId} {
      allow get, list: if isSignedIn() && hasAllowedRole() && companyId == userCompanyId();
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if isAdmin() && companyId == userCompanyId();
    }

    // Mines: company-scoped
    match /mines/{mineId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if isAdmin() && sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    // Exam and document collections — company match required on read and write
    match /workplace_exams/{examId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    match /equipment_exams/{examId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    match /required_documents/{docId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    match /training_documents/{docId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    match /exam_attachments/{attachmentId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    match /equipment_attachments/{attachmentId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }

    match /schedules/{scheduleId} {
      allow read: if sameCompany(resource.data);
      allow create: if isSignedIn() && hasAllowedRole() && request.resource.data.companyId == userCompanyId();
      allow update, delete: if sameCompany(resource.data) && request.resource.data.companyId == userCompanyId();
    }
  }
}
