rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /workplace_exams/{allPaths=**} {
      allow read, write: if true;
    }
    match /site_photos/{allPaths=**} {
      allow read, write: if true;
    }
    match /equipment_photos/{allPaths=**} {
      allow read, write: if true;
    }
    // Shared compliance files. Open during testing, same as the collections above.
    match /required_documents/{allPaths=**} {
      allow read, write: if true;
    }
    match /training_documents/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
